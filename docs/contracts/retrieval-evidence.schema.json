{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/antonmitsev/applied-ai-lab/main/docs/contracts/retrieval-evidence.schema.json",
  "title": "PA-EVIDENCE-001 validated retrieval evidence bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bundle_id",
    "language",
    "retrieval_status",
    "active_registry_version",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "bundle_id": {
      "type": "string",
      "pattern": "^evb_[a-zA-Z0-9_-]{16,100}$"
    },
    "language": {
      "enum": ["bg", "en"]
    },
    "retrieval_status": {
      "enum": ["sufficient", "insufficient", "blocked"]
    },
    "active_registry_version": {
      "type": ["string", "null"],
      "maxLength": 100
    },
    "items": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/evidenceItem"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "retrieval_status": {
            "const": "sufficient"
          }
        },
        "required": ["retrieval_status"]
      },
      "then": {
        "properties": {
          "items": {
            "minItems": 1,
            "contains": {
              "properties": {
                "trust_decision": {
                  "const": "eligible"
                }
              },
              "required": ["trust_decision"]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "evidenceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "source_kind",
        "source_id",
        "title",
        "canonical_url",
        "publisher_domain",
        "source_tier",
        "authority_class",
        "language",
        "excerpt",
        "relevance_score",
        "claim_scopes",
        "risk_flags",
        "trust_decision"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "pattern": "^ev_[a-zA-Z0-9_-]{12,100}$"
        },
        "source_kind": {
          "enum": ["curated", "live_web"]
        },
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "canonical_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "maxLength": 2000
        },
        "publisher_domain": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9.-]{0,251}[a-z0-9])?$",
          "maxLength": 253
        },
        "source_tier": {
          "enum": ["manufacturer", "authority", "professional", "secondary"]
        },
        "authority_class": {
          "enum": [
            "manufacturer_model",
            "manufacturer_family",
            "public_authority",
            "recognized_standard",
            "professional_body",
            "reputable_secondary"
          ]
        },
        "language": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"
        },
        "excerpt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "relevance_score": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "claim_scopes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "general_context",
              "diagnostic_explanation",
              "safety_guidance",
              "procedural_guidance",
              "compatibility_family",
              "compatibility_exact",
              "regulatory_guidance"
            ]
          }
        },
        "risk_flags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "none",
              "instruction_like",
              "policy_override",
              "secret_request",
              "tool_request",
              "data_exfiltration",
              "encoded_payload",
              "citation_spoofing",
              "suspicious_link",
              "hidden_or_obfuscated_text"
            ]
          }
        },
        "trust_decision": {
          "enum": ["eligible", "quarantined"]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "trust_decision": {
                "const": "eligible"
              }
            },
            "required": ["trust_decision"]
          },
          "then": {
            "properties": {
              "risk_flags": {
                "const": ["none"]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "source_kind": {
                "const": "live_web"
              }
            },
            "required": ["source_kind"]
          },
          "then": {
            "properties": {
              "claim_scopes": {
                "not": {
                  "contains": {
                    "const": "compatibility_exact"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "trust_decision": {
                "const": "quarantined"
              }
            },
            "required": ["trust_decision"]
          },
          "then": {
            "properties": {
              "risk_flags": {
                "not": {
                  "contains": {
                    "const": "none"
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
