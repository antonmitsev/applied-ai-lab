# Server-side only. Never expose this value to browser code.
OPENAI_API_KEY=replace-with-a-project-api-key

# Comma-separated Ed25519 public keys accepted by the admin statistics API.
ADMIN_PUBLIC_KEYS=key-id:base64-public-key

# Used to authenticate anonymous visitor tokens and pseudonymize rate-limit keys.
VISITOR_TOKEN_SECRET=replace-with-a-long-random-value

# Persistent storage location for a single-server deployment.
USAGE_STORE_PATH=./runtime-data/usage.sqlite
